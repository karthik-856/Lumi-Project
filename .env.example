# Optional. Lumi runs without this file and without any API key.
# The frontend reads VITE_API_URL from frontend/.env. See frontend/.env.example.
# VITE_API_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed to call the API.
# Defaults to the Vite dev server on port 4731.
# LUMI_CORS_ORIGINS=http://127.0.0.1:4731,http://localhost:4731

# SQLite file created on first API start. Defaults to backend/lumi.db.
# LUMI_DB=
